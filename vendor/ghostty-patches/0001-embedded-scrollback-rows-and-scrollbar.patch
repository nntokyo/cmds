From: RYO <info@n-n.tokyo>
Subject: [PATCH] apprt/embedded: exact screen points above the viewport,
 ghostty_surface_scrollbar

ghostty_surface_read_text clamped the y of every exact point to the
viewport height, screen and history points too, so an embedder could not
read a row of the scrollback above the viewport without scrolling the
viewport there first. Clamp only active and viewport points; screen and
history points reach every row (PageList.pin returns null past the end,
so read_text returns false as for any other invalid point).

ghostty_surface_scrollbar returns the active screen's scrollbar (total
rows, offset of the viewport's top, viewport rows) synchronously, under
the renderer state mutex like read_text. The scrollbar action carries the
same values, but only when the renderer draws a frame, so it is stale
while the surface is not drawn. Together they let an embedder read the
rows right above the viewport (screen rows offset-n ..< offset) without
moving it.

It also returns PageList.pruned_rows, the rows pruned from the top of the
scrollback to stay within its limits (grow, Limits.enforce) since the
screen was created. Screen rows move up by that much, so an embedder that
remembers a screen row (e.g. the last one it sent elsewhere) can find it
again after pruning instead of starting over. Erasing the history, resets
and resizes are not counted.

cmds carries this on Ghostty b2c78c9bd9bc (scripts/build-ghostty.sh
applies it for the build and reverts it afterwards).
---
 include/ghostty.h         | 11 +++++++++++
 src/apprt/embedded.zig    | 43 +++++++++++++++++++++++++++++++++++++++++--
 src/terminal/PageList.zig | 12 ++++++++++++
 3 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/include/ghostty.h b/include/ghostty.h
index 9a12b9c..c0a68f8 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -529,6 +529,16 @@ typedef struct {
   uint32_t cell_height_px;
 } ghostty_surface_size_s;
 
+// Scrollbar of the active screen (ghostty_surface_scrollbar): rows of the
+// whole screen, screen row at the top of the viewport, viewport rows, and
+// rows pruned from the top of the scrollback so far.
+typedef struct {
+  uint64_t total;
+  uint64_t offset;
+  uint64_t len;
+  uint64_t pruned;
+} ghostty_surface_scrollbar_s;
+
 // Config types
 
 // config.Path
@@ -1240,6 +1250,7 @@ GHOSTTY_API bool ghostty_surface_read_text(ghostty_surface_t,
                                               ghostty_selection_s,
                                               ghostty_text_s*);
 GHOSTTY_API void ghostty_surface_free_text(ghostty_surface_t, ghostty_text_s*);
+GHOSTTY_API ghostty_surface_scrollbar_s ghostty_surface_scrollbar(ghostty_surface_t);
 
 #ifdef __APPLE__
 GHOSTTY_API void ghostty_surface_set_display_id(ghostty_surface_t, uint32_t);
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 697f0a7..0f65de8 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -1610,6 +1610,14 @@ pub const CAPI = struct {
         }
     };
 
+    // ghostty_surface_scrollbar_s
+    const SurfaceScrollbar = extern struct {
+        total: u64,
+        offset: u64,
+        len: u64,
+        pruned: u64,
+    };
+
     // ghostty_point_s
     const Point = extern struct {
         tag: Tag,
@@ -1642,9 +1650,15 @@ pub const CAPI = struct {
                 ),
             };
 
-            // Clamp our point to the screen bounds.
+            // Clamp our point to the screen bounds. Only the active area and
+            // the viewport are one screen tall: screen and history points
+            // reach every row of the scrollback (pin returns null past the
+            // last row of the screen).
             const clamped_x = @min(self.x, screen.pages.cols -| 1);
-            const clamped_y = @min(self.y, screen.pages.rows -| 1);
+            const clamped_y: u32 = switch (self.tag) {
+                .active, .viewport => @min(self.y, screen.pages.rows -| 1),
+                .screen, .history => self.y,
+            };
 
             return switch (self.coord_tag) {
                 // Exact coordinates require a specific pin.
@@ -1980,6 +1994,31 @@ pub const CAPI = struct {
         ptr.deinit();
     }
 
+    /// The scrollbar of the active screen, read now: the total rows of the
+    /// screen (scrollback and active area), the row offset of the
+    /// viewport's top and the viewport's height. The scrollbar action
+    /// carries the same values but only when the renderer draws a frame,
+    /// so it is stale while the surface is not drawn. With exact screen
+    /// points, rows above the viewport can be read without moving it:
+    /// screen row offset - 1 is the row right above the viewport.
+    ///
+    /// `pruned` counts the rows pruned from the top of the scrollback to
+    /// stay within its limits since the screen was created: a screen row
+    /// read earlier moved up by the difference. Clearing the history,
+    /// resets and resizes do not count.
+    export fn ghostty_surface_scrollbar(surface: *Surface) SurfaceScrollbar {
+        surface.core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer surface.core_surface.renderer_state.mutex.unlock(global.io());
+        const pages = &surface.core_surface.renderer_state.terminal.screens.active.pages;
+        const bar = pages.scrollbar();
+        return .{
+            .total = @intCast(bar.total),
+            .offset = @intCast(bar.offset),
+            .len = @intCast(bar.len),
+            .pruned = pages.pruned_rows,
+        };
+    }
+
     /// Tell the surface that it needs to schedule a render
     export fn ghostty_surface_refresh(surface: *Surface) void {
         surface.refresh();
diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
