      <title>cmds 0.27.1</title>
      <link>https://github.com/nntokyo/cmds/releases/tag/v0.27.1</link>
      <sparkle:version>41</sparkle:version>
      <sparkle:shortVersionString>0.27.1</sparkle:shortVersionString>
