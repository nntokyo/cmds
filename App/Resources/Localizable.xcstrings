          }
        }
      }
    },
    "Waiting for iOS Sync": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS同期を待機中"
          }
        }
      }
    },
    "Waiting: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中：%@"
          }
        }
      }
    },
    "While cmds runs, the Mac does not go to sleep when idle (the display may still turn off). Closing the lid still sleeps it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsの実行中は、アイドル時にMacがスリープしません（ディスプレイはオフになることがあります）。蓋を閉じるとスリープします。"
          }
        }
      }
    },
    "While cmds runs, the display does not turn off when idle.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsの実行中は、アイドル時にディスプレイがオフになりません。"
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ"
          }
        }
      }
    },
    "Working": {
