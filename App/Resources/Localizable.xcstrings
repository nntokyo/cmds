        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が失敗しました：%2$@"
          }
        }
      }
    },
    "%@ is a bare repository, without a working tree to start from.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はベアリポジトリで、元にする作業ツリーがありません。"
          }
        }
      }
    },
    "%@ is a folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はフォルダです"
          }
        }
      }
    },
    "%@ is inside the repository. Choose a folder outside it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はリポジトリの中にあります。リポジトリの外のフォルダを選んでください。"
          }
        }
      }
    },
    "%@ is not in a git repository.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はgitリポジトリの中にありません。"
          }
        }
      }
    },
    "%@ limit": {
      "comment": "agent usage limit of a window (1h limit)",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の上限"
          }
        }
