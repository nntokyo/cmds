          }
        }
      }
    },
    "Keep Both": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方とも残す"
          }
        }
      }
    },
    "Keep Display Awake": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをスリープしない"
          }
        }
      }
    },
    "Keep It Disabled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効のままにする"
          }
        }
      }
    },
    "Keep Mine": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の版を残す"
          }
        }
      }
    },
    "Keep Mine uploads your version over it. Keep Theirs replaces your edited copy with the server's version. Save Mine as a Copy uploads your version under a numbered name, and later saves go there. Cancel uploads nothing now; saving again asks again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“自分の版を残す”はサーバのファイルを自分の版で置き換えます。“サーバの版を残す”は編集用のコピーをサーバの版で置き換えます。“自分の版をコピーとして保存”は番号付きの名前でアップロードし、以後の保存はそちらに行きます。“キャンセル”は今は何もアップロードせず、次に保存したときにもう一度確認します。"
          }
        }
      }
    },
    "Keep Theirs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバの版を残す"
          }
        }
      }
    },
    "Keep this Mac awake with the lid closed?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じてもこのMacをスリープしないようにしますか？"
          }
        }
      }
    },
    "Keyboard Shortcuts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカット"
          }
        }
      }
    },
    "Kind": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "Large": {
      "comment": "sidebar text size",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大"
          }
        }
      }
    },
    "Last Result": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の結果"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        }
      }
    },
    "Latest notification": {
      "comment": "Settings › Sidebar › Show in each workspace",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の通知"
          }
        }
      }
    },
    "Layered over your Ghostty config. View › Bigger / Smaller / Actual Size (⌘+ / ⌘− / ⌘0) change only the focused pane.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghostty の設定より優先されます。表示 › 大きく／小さく／実際のサイズ（⌘+／⌘−／⌘0）は、フォーカスしているペインだけを変えます。"
          }
        }
      }
    },
    "Leave empty to use the directory name.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にするとディレクトリ名を使います。"
          }
        }
      }
    },
    "Left": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左"
          }
        }
      }
    },
    "Left is newer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左が新しい"
          }
        }
      }
    },
    "Left wins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左を優先"
          }
        }
      }
    },
    "Left ← Right": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 ← 右"
          }
        }
      }
    },
    "Left → Right": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左 → 右"
          }
        }
      }
    },
    "Left: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左：%@"
          }
        }
      }
    },
    "Lets a paired iPhone/iPad reach this Mac away from home through an SSH server you use. The connection stays encrypted end to end.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのiPhone/iPadから、普段使っているSSHサーバー経由で外出先からこのMacに接続できるようにします。接続はエンドツーエンドで暗号化されたままです。"
          }
        }
      }
    },
    "Lets the iPhone/iPad connect over Bluetooth when Wi‑Fi is off. The connection stays encrypted and pinned to this Mac's identity.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fiがオフのとき、iPhone/iPadがBluetoothで接続できるようにします。接続は暗号化され、このMacの識別情報に固定されたままです。"
          }
        }
      }
    },
    "Lets your paired iPhone or iPad reach this Mac away from home through an SSH server you already use (the relay host). cmds keeps “ssh -R” open to it; the forwarded port listens only on the relay's loopback. The phone logs in to the relay with its own key and opens the forwarded port; the session inside stays end-to-end TLS pinned to this Mac, so the relay sees only ciphertext. Pair on the local network first: pairing codes are not accepted over SSH.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのiPhone/iPadから、すでに使っているSSHサーバー（中継ホスト）経由で外出先からこのMacに接続できるようにします。cmdsは中継ホストへの「ssh -R」を維持し、転送ポートは中継ホストのループバックでのみ待ち受けます。iPhoneは自分の鍵で中継ホストにログインして転送ポートを開きます。その中のセッションはこのMacに固定されたエンドツーエンドのTLSのままなので、中継ホストには暗号文しか見えません。先にローカルネットワークでペアリングしてください。SSH経由ではペアリングコードを受け付けません。"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        }
      }
    },
    "Limit — %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限 — %@"
          }
        }
      }
    },
    "Lines +%lld −%lld": {
      "comment": "lines changed by the agent",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lines +%1$lld −%2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更行 +%1$lld −%2$lld"
          }
        }
      }
    },
    "Link (not synced)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク（同期しません）"
          }
        }
      }
    },
    "Linked elsewhere": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所にリンク"
          }
        }
      }
    },
    "Listening on port %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート%@で待ち受け中"
          }
        }
      }
    },
    "Listening ports": {
      "comment": "Settings › Sidebar › Show in each workspace",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち受けポート"
          }
        }
      }
    },
    "Lists a folder on an SSH host over SFTP with your ssh (~/.ssh/config, keys, agent). cmds never asks for or stores passwords, and only connects to hosts whose key is already in known_hosts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSHホストのフォルダを、お使いのssh（~/.ssh/config、鍵、エージェント）でSFTP経由で一覧表示します。cmdsはパスワードを尋ねることも保存することもなく、ホスト鍵がknown_hostsにあるホストにだけ接続します。"
          }
        }
      }
    },
    "Location:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所："
          }
        }
      }
    },
    "Mac identity: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの識別情報：%@"
          }
        }
      }
    },
    "Mac is on battery": {
      "localizations": {
        "ja": {
