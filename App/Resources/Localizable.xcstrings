    },
    "%@ already exists.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでにあります。"
          }
        }
      }
    },
    "%@ failed: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ failed: %2$@"
