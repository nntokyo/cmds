      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告"
          }
        }
      }
    },
    "workspace title (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのタイトル（省略可）"
          }
        }
      }
    },
    "workspace “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース「%@」"
          }
        }
      }
    },
    "“%@” already exists in this folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには“%@”がすでにあります。"
          }
        }
      }
    },
    "“%@” appeared in the destination during the copy and was left as it is (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” appeared in the destination during the copy and was left as it is (%2$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー中に移動先に“%1$@”ができたため、そのままにしました（%2$@）。"
          }
        }
      }
    },
    "“%@” changed on the server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ上の“%@”が変更されました"
          }
        }
      }
    },
    "“%@” has changed on the server since you downloaded or last uploaded it.": {
      "localizations": {
