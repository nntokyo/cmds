    " · %@ of %@ tokens": {
      "comment": "after Context 53%: 527k of 1M tokens",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " · %1$@ of %2$@ tokens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · %1$@ / %2$@トークン"
          }
        }
      }
    },
    " · %@ of the window elapsed": {
      "comment": "after an agent usage limit",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · 期間の%@が経過"
          }
        }
      }
