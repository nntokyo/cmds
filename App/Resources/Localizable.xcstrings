      }
    },
    "“%@” hit its limit. Continuing with “%@” once Claude Code is idle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@” hit its limit. Continuing with “%2$@” once Claude Code is idle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”が上限に達しました。Claude Codeが待機状態になったら“%2$@”で続けます。"
          }
        }
      }
    },
    "“%@” is not a folder.": {
