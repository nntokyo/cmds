        }
      }
    },
    "%@: left alone (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: left alone (%2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：変更しません（%2$@）"
          }
        }
