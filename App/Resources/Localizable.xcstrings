          }
        }
      }
    },
    "Working…": {
      "comment": "subagent without a current tool call",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中…"
          }
        }
      }
    },
    "Workspace": {
      "comment": "default workspace title",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース"
          }
        }
      }
    },
    "Workspace %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース%lld"
          }
        }
      }
    },
    "Workspace title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのタイトル"
          }
        }
      }
    },
    "Workspaces and their agent sessions, to import into another cmds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースとエージェントのセッション（別のcmdsで読み込めます）"
          }
        }
      }
    },
    "Workspaces with agents": {
      "comment": "Settings › Menu Bar › Menu",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのワークスペース"
          }
        }
      }
    },
    "Workspaces: %lld, agent sessions: %lld. Add keeps the open workspaces; Replace closes them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Workspaces: %1$lld, agent sessions: %2$lld. Add keeps the open workspaces; Replace closes them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペース：%1$lld、エージェントのセッション：%2$lld。「追加」は開いているワークスペースを残し、「置き換える」はそれらを閉じます。"
          }
        }
      }
    },
    "You can also run: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のコマンドでも元に戻せます：%@"
          }
        }
      }
    },
    "You may be asked for an administrator password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者パスワードを求められる場合があります。"
          }
        }
      }
    },
    "Your changes stay in the edited copy. Save it again, or retry in Window › Transfers.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は編集用のコピーに残っています。もう一度保存するか、ウインドウ › 転送で再試行してください。"
          }
        }
      }
    },
    "Zoom": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大／縮小"
          }
        }
      }
    },
    "Zoom Pane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインを拡大"
          }
        }
      }
    },
    "Zoom Tile": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイルを拡大"
          }
        }
      }
    },
    "Zoom Tile (⇧⌘↩)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイルを拡大（⇧⌘↩）"
          }
        }
      }
    },
    "a closed pane": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたペイン"
          }
        }
      }
    },
    "a folder in the repository": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリ内のフォルダ"
          }
        }
      }
    },
    "a pane of “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のペイン"
          }
        }
      }
    },
    "and %lld more": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほか%lld件"
          }
        }
      }
    },
    "cmds created the worktree %@ (branch %@) for this workspace. Close and Remove Worktree also removes that folder with git worktree remove: files git ignores (build output, dependencies) go with it, the branch stays. It is not removed while it has uncommitted changes, untracked files or commits that are not pushed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "cmds created the worktree %1$@ (branch %2$@) for this workspace. Close and Remove Worktree also removes that folder with git worktree remove: files git ignores (build output, dependencies) go with it, the branch stays. It is not removed while it has uncommitted changes, untracked files or commits that are not pushed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースのワークツリー%1$@（ブランチ%2$@）はcmdsが作成しました。「閉じてワークツリーを削除」はgit worktree removeでそのフォルダも削除します。gitが無視するファイル（ビルド結果、依存パッケージ）も一緒に削除され、ブランチは残ります。コミットされていない変更、追跡されていないファイル、プッシュされていないコミットがあるあいだは削除しません。"
          }
        }
      }
    },
    "cmds creates a new key and certificate for iOS Sync and unpairs every iPhone and iPad. Each one must be paired again; until then they report that this Mac's identity changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsはiOS同期用の新しい鍵と証明書を作成し、すべてのiPhone/iPadのペアリングを解除します。それぞれ再度ペアリングが必要で、それまではこのMacの識別情報が変わったと表示されます。"
          }
        }
      }
    },
    "cmds did not create the worktree %@, so it never removes it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリー%@はcmdsが作成したものではないため、削除しません。"
          }
        }
      }
    },
    "cmds does not look for updates by itself. cmds › Check for Updates… looks now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを自動では確認しません。cmds › アップデートを確認… で今すぐ確認できます。"
          }
        }
      }
    },
    "cmds keeps it awake with the lid closed. A closed Mac that never sleeps drains the battery and can overheat in a bag.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsは蓋を閉じてもスリープしないようにしています。スリープしないMacを閉じたままにすると、バッテリーを消耗し、バッグの中で過熱することがあります。"
          }
        }
      }
    },
    "cmds quit during the run.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中にcmdsが終了しました。"
          }
        }
      }
    },
    "cmds turned on “Keep Awake With Lid Closed” before and did not turn it off (it quit unexpectedly, or the password dialog was cancelled). Your Mac currently does not sleep when you close the lid. Restore normal sleep now? macOS will ask for your administrator password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前cmdsが「蓋を閉じてもスリープしない」をオンにしたまま、オフにできませんでした（予期せず終了したか、パスワードのダイアログがキャンセルされました）。現在、このMacは蓋を閉じてもスリープしません。今すぐ通常のスリープに戻しますか？ macOSが管理者パスワードを求めます。"
          }
        }
      }
    },
    "cmds will type one command into this pane's remote shell. It writes ~/.local/bin/cmds-remote.sh (a small sh script; needs python3, socat or nc there) and, if the server has no `cmds` command, ~/.local/bin/cmds linking to it. Nothing else changes.\n\nMake sure the pane shows a shell prompt (no program running) before you continue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsはこのペインのリモートシェルにコマンドを1つ入力します。~/.local/bin/cmds-remote.sh（小さなshスクリプト。サーバーにpython3、socat、ncのいずれかが必要）を書き込み、サーバーに`cmds`コマンドがなければそれへのリンク~/.local/bin/cmdsも作成します。ほかには何も変更しません。\n\n続ける前に、ペインにシェルのプロンプトが表示されている（プログラムが実行中でない）ことを確認してください。"
          }
        }
      }
    },
    "command (optional, e.g. claude)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド（省略可、例：claude）"
          }
        }
      }
    },
