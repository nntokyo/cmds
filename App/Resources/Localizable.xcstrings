    " · %@ out": {
      "comment": "after Tokens: output tokens",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · 出力%@"
          }
        }
      }
    },
    " · %@ tokens": {
      "comment": "after Context 53%",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · %@トークン"
          }
        }
