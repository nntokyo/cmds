    " · warm": {
      "comment": "prompt cache still alive",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · 有効"
          }
        }
      }
    },
    "%@ %@ of %@ (%@)": {
      "comment": "Spend limit $12.00 of $50.00 (24%)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ of %3$@ (%4$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%3$@中%2$@（%4$@）"
          }
        }
      }
    },
    "%@ %@ used": {
      "comment": "agent usage limit: 5-hour limit 40% used",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
