    "skipped (the name is taken)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ（同じ名前があります）"
          }
        }
      }
    },
    "spend": {
      "comment": "short label of an agent's spend limit (spend $12/$50)",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用額"
          }
        }
      }
    },
    "ssh uses your ~/.ssh/config, keys and known_hosts for this host and never prompts (BatchMode). On the phone: Settings › Remote Access, same host, your user name there and this relay port.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sshはこのホストの~/.ssh/config、鍵、known_hostsを使い、入力を求めません（BatchMode）。iPhoneでは「SSH経由のリモートアクセス…」で、同じホスト、そのホストでのユーザー名、この中継ポートを指定します。"
          }
        }
      }
    },
    "unknown": {
