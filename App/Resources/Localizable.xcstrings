    "In Tiled View Only": {
      "comment": "show subagents",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル表示のときだけ"
          }
        }
      }
    },
    "In cmds on your iPhone or iPad, tap Scan Pairing Code and point it at this QR code. Without a camera: pick this Mac, check that the identity matches, and enter the code.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone/iPadのcmdsで「ペアリングコードをスキャン」をタップし、このQRコードに向けてください。カメラがない場合は、このMacを選び、識別情報が一致することを確認してからコードを入力します。"
          }
        }
      }
    },
    "Include items whose names start with a dot (compares again)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前がドットで始まる項目も含めます（もう一度比較します）"
          }
        }
      }
    },
    "Inspect browser panes with Safari › Develop (turn on Show features for web developers in Safari's Advanced settings).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの「開発」メニューからブラウザペインを調べられます（Safariの詳細設定で「Web デベロッパ用の機能を表示」をオンにしてください）。"
          }
        }
      }
    },
    "Install": {
      "localizations": {
