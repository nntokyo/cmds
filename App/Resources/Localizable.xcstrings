{
  "sourceLanguage": "en",
  "strings": {
    " %@ in": {
      "comment": "after Tokens: input tokens",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 入力%@"
          }
        }
      }
    },
    " (%@ cached)": {
      "comment": "after the input tokens",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（キャッシュ%@）"
          }
        }
      }
    },
    " (%@ reasoning)": {
      "comment": "after the output tokens",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（推論%@）"
          }
        }
      }
    },
    " (%lld%% of wall time)": {
      "comment": "after the API time",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（経過時間の%lld%%）"
