    " · API %@": {
      "comment": "after Session: time in API calls",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · API %@"
          }
        }
      }
    },
    " · cold": {
      "comment": "prompt cache expired",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " · 期限切れ"
