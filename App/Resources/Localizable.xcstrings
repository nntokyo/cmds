    },
    "A coding agent is running in this workspace. Closing it ends the agent and its terminals.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースではコーディングエージェントが動いています。閉じるとエージェントとターミナルが終了します。"
          }
        }
      }
    },
    "A program in this terminal wants to read the clipboard. Allow it?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルのプログラムがクリップボードを読み取ろうとしています。許可しますか？"
          }
        }
      }
    },
    "About cmds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmdsについて"
          }
        }
      }
    },
    "Actual Size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のサイズ"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Advertising (PSM %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドバタイズ中（PSM %@）"
          }
        }
      }
    },
    "Agents keep running when you close the lid. cmds changes a system-wide power setting (pmset -a disablesleep 1) and changes it back when you turn this off or quit cmds. macOS asks for your administrator password each time; cmds never sees it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じてもエージェントは動き続けます。cmdsはシステム全体の電源設定（pmset -a disablesleep 1）を変更し、この設定をオフにするかcmdsを終了すると元に戻します。macOSはそのたびに管理者パスワードを求めます。cmdsがパスワードを見ることはありません。"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可"
          }
        }
      }
    },
    "Allow Bluetooth Sync": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth同期を許可"
          }
        }
      }
    },
    "Allow remote access via SSH": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH経由のリモートアクセスを許可"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に再開"
          }
        }
      }
    },
    "App %@ · Wired %@ · Compressed %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "App %1$@ · Wired %2$@ · Compressed %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
