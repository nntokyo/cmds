    },
    "Apply": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する"
          }
        }
      }
    },
    "Awake (lid closed OK)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープしない（蓋を閉じても可）"
          }
        }
      }
    },
    "Awake (lid closed OK): cmds turned sleep off (pmset disablesleep 1). Closing the lid does not sleep this Mac until you turn it off or quit cmds. Click to turn it off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープしない（蓋を閉じても可）：cmdsがスリープをオフにしました（pmset disablesleep 1）。オフにするかcmdsを終了するまで、蓋を閉じてもこのMacはスリープしません。クリックするとオフにします。"
          }
        }
      }
    },
    "Awake (lid closed OK): sleep is disabled system-wide, not by cmds (SleepDisabled = 1). Restore with: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープしない（蓋を閉じても可）：cmds以外によってシステム全体でスリープが無効になっています（SleepDisabled = 1）。元に戻すには：%@"
          }
        }
      }
    },
