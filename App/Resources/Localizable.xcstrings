    },
    "%@: projects becomes a link to the shared folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：projectsを共有フォルダへのリンクにします"
          }
        }
      }
    },
    "%@: quitting stops their uploads. Their edited copies stay in %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：終了するとアップロードが止まります。編集用のコピーは%2$@に残ります。"
          }
        }
      }
    },
    "%lld AI agent sessions are running in cmds. Quitting ends them; you can resume them later from the saved sessions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmds の中で AI エージェントのセッションが %lld 件動いています。終了すると中断されます（保存されたセッションから後で再開できます）。"
          }
