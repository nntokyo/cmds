          "stringUnit": {
            "state": "translated",
            "value": "%@ トークン"
          }
        }
      }
    },
    "%@: its projects folder is renamed to %@ (kept, not deleted), then linked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: its projects folder is renamed to %2$@ (kept, not deleted), then linked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：projectsフォルダを%2$@に名前変更して（削除せずに残します）からリンクします"
          }
        }
      }
    },
    "%@: keeps %@ (the shared folder)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: keeps %2$@ (the shared folder)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@をそのまま使います（共有フォルダ）"
