{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmds connects to your Mac over Bluetooth when it cannot reach it over Wi‑Fi. The connection stays end-to-end encrypted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi‑Fi経由でMacに接続できないとき、cmdsはBluetoothでMacに接続します。接続はエンドツーエンドで暗号化されたままです。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmds scans the pairing QR code shown by cmds on your Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmdsはMacのcmdsに表示されるペアリング用QRコードを読み取ります。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmds connects to your Mac to mirror terminals."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cmdsはMacに接続してターミナルをミラーリングします。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
