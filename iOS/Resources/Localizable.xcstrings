{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is shown on the Mac." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はMacに表示されています。"
          }
        }
      }
    },
    "%@ limits: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ limits: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の利用上限：%2$@"
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@, idle" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、アイドル"
          }
        }
      }
    },
    "Active on Mac" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで使用中"
          }
        }
      }
    },
    "Add this line to ~/.ssh/authorized_keys of that user on the relay host (replace an older cmds line for this device: it lists the relay ports of all your Macs). It only allows forwarding to those ports: no shell. The private key never leaves this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この行を中継ホストの該当ユーザの ~/.ssh/authorized_keys に追加してください（このデバイス用の古いcmdsの行があれば置き換えてください。この行にはすべてのMacの中継ポートが含まれます）。許可されるのはそれらのポートへの転送だけで、シェルは使えません。秘密鍵がこのデバイスの外に出ることはありません。"
          }
        }
      }
    },
    "Allow camera access for cmds in Settings, or pair without the camera." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でcmdsのカメラへのアクセスを許可するか、カメラを使わずにペアリングしてください。"
          }
        }
      }
    },
    "Authenticating…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証中…"
          }
        }
      }
    },
    "Bad message from the Mac: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macから不正なメッセージを受信しました：%@"
